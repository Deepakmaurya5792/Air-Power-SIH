# AIR POWER Platform - Global Root Environment Reference
# Note: Copy individual .env.example files inside frontend, backend, and ml-service

# Gateway Configuration
PORT=8000
NODE_ENV=development
ML_SERVICE_URL=http://127.0.0.1:8001

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000

# Security Secrets & Tokens (Replace with high-entropy keys for production)
JWT_SECRET=your_jwt_secret_token_here
SESSION_SECRET=your_session_secret_key_here
API_KEY=your_api_gateway_key_here
ML_SECRET_KEY=your_secret_inference_key_here
